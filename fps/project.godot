; Istanbul-Z — voxel FPS (Godot 4.7.2-stable)
; Bu dosya Godot tarafindan da duzenlenebilir; elle duzenlerken bolum
; adlarini ve anahtar bicimini koruyun.

config_version=5

[application]

config/name="Istanbul-Z"
config/description="Istanbul sokaklarinda birinci sahis voxel zombi hayatta kalma ve koloni oyunu."
config/version="0.5.0"
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.08, 0.1, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="IstanbulZ"

[autoload]

Content="*res://src/autoload/content.gd"
Settings="*res://src/autoload/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[gui]

theme/custom_font="res://assets/fonts/Barlow-Medium.ttf"
theme/default_font_antialiasing=1
theme/default_font_hinting=1
theme/default_font_subpixel_positioning=1

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=1
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.52, 0.62, 0.72, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
